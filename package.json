{
  "name": "@bubblav/ai-chatbot-angular",
  "version": "1.0.5",
  "description": "BubblaV AI chatbot widget for Angular applications",
  "peerDependencies": {
    "@angular/common": ">=14.0.0",
    "@angular/core": ">=14.0.0"
  },
  "devDependencies": {
    "@angular/core": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "ng-packagr": "^21.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'); const pkg=require('./package.json'); delete pkg.exports; fs.writeFileSync('./package.json', JSON.stringify(pkg, null, 2));\"",
    "build": "ng-packagr -p ng-package.json && node build-postprocess.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "bubblav",
    "chatbot",
    "ai",
    "widget",
    "angular",
    "customer-support"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bubblav-org/ai-chatbot-angular.git",
    "directory": "packages/ai-chatbot-angular"
  },
  "homepage": "https://docs.bubblav.com/user-guide/installation",
  "module": "dist/fesm2022/bubblav-ai-chatbot-angular.mjs",
  "typings": "dist/types/bubblav-ai-chatbot-angular.d.ts",
  "sideEffects": false,
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "main": "dist/fesm2022/bubblav-ai-chatbot-angular.mjs",
  "types": "dist/types/bubblav-ai-chatbot-angular.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/types/bubblav-ai-chatbot-angular.d.ts",
      "import": "./dist/fesm2022/bubblav-ai-chatbot-angular.mjs",
      "default": "./dist/fesm2022/bubblav-ai-chatbot-angular.mjs"
    }
  }
}